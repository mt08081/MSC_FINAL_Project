<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE experiments>
<experiments>
  
  <!-- EXPERIMENT 1: Tolerance Sensitivity Analysis -->
  <experiment name="exp1_tolerance_sensitivity" repetitions="5" runMetricsEveryStep="false">
    <setup>setup2</setup>
    <go>go</go>
    <timeLimit steps="100"/>
    
    <!-- Parameters to vary -->
    <enumeratedValueSet variable="rel-tolerance">
      <value value="20"/>
      <value value="40"/>
      <value value="60"/>
      <value value="80"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="lang-tolerance">
      <value value="20"/>
      <value value="40"/>
      <value value="60"/>
      <value value="80"/>
    </enumeratedValueSet>
    
    <!-- Fixed parameters -->
    <enumeratedValueSet variable="rel-weight">
      <value value="0.5"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="lang-weight">
      <value value="0.5"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="birth-rate">
      <value value="2.5"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="death-rate">
      <value value="1"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="search-radius">
      <value value="5"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="viz-mode">
      <value value="&quot;Religion&quot;"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="rel-focus">
      <value value="&quot;Muslim&quot;"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="lang-focus">
      <value value="&quot;Urdu&quot;"/>
    </enumeratedValueSet>
    
    <!-- Metrics to collect at end of run -->
    <metric>ticks</metric>
    <metric>count households</metric>
    <metric>count households with [religion = "Muslim"]</metric>
    <metric>count households with [religion = "Hindu"]</metric>
    <metric>count households with [religion = "Christian"]</metric>
    <metric>count households with [religion = "Other"]</metric>
    <metric>count households with [language = "Urdu"]</metric>
    <metric>count households with [language = "Sindhi"]</metric>
    <metric>count households with [language = "Pashto"]</metric>
    <metric>count households with [language = "Other"]</metric>
    <metric>mean [similar-nearby-rel] of households</metric>
    <metric>mean [similar-nearby-lang] of households</metric>
    <metric>mean [pct-similar-rel] of households</metric>
    <metric>mean [pct-similar-lang] of households</metric>
    <metric>max [m-muslim] of managers</metric>
    <metric>max [m-hindu] of managers</metric>
    <metric>max [m-christian] of managers</metric>
    <metric>max [m-urdu] of managers</metric>
    <metric>max [m-sindhi] of managers</metric>
    <metric>max [m-pashto] of managers</metric>
    <metric>standard-deviation [m-total] of managers</metric>
  </experiment>
  
  
